# Copy this file to .env and fill in your key.
# Create a Gemini API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# Optional: Gemini model to use (default: gemini-3.8-flash)
# GEMINI_MODEL=gemini-3.8-flash

# Optional: port for the web server (default: 3000)
# PORT=3000
